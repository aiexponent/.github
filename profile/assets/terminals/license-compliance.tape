# License Compliance Checker Terminal Execution Tape
# Charm VHS (vhs.charm.sh) script for recording Article 53 GPAI and model dependency scanner output

Output license-compliance-terminal.svg
Output license-compliance-terminal.gif

Set FontSize 14
Set FontFamily "Menlo, Monaco, Consolas, DejaVu Sans Mono, monospace"
Set Width 920
Set Height 500
Set Padding 24
Set WindowBar Colorful
Set WindowBarSize 36
Set LetterSpacing 0
Set LineHeight 1.3
Set Theme { "background": "#0F1419", "foreground": "#FAF7F2", "black": "#161D26", "red": "#F87171", "green": "#34D399", "yellow": "#FBBF24", "blue": "#60A5FA", "magenta": "#C084FC", "cyan": "#5DB7C8", "white": "#FAF7F2", "brightBlack": "#475569", "brightRed": "#EF4444", "brightGreen": "#10B981", "brightYellow": "#F59E0B", "brightBlue": "#3B82F6", "brightMagenta": "#A855F7", "brightCyan": "#22D3EE", "brightWhite": "#FFFFFF" }

Type "lcc scan . --policy eu-ai-act-compliance --format table"
Sleep 400ms
Enter

Sleep 3s
